  "strings": {
    "Check your internet connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your internet connection and try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua conexão com a internet e tente novamente."
          }
        }
      }
    },
    "The email or password is incorrect.": {
