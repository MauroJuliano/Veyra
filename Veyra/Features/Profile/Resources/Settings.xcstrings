{
  "sourceLanguage": "en",
  "strings": {
    "About Veyra": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über Veyra"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About Veyra"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre o Veyra"
          }
        }
      }
    },
    "Allow notifications": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir notificações"
          }
        }
      }
    },
    "Allow Veyra to notify you about new activity.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Veyra, dich über neue Aktivitäten zu informieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Veyra to notify you about new activity."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o Veyra avise sobre novas atividades."
          }
        }
      }
    },
    "Checking permission": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigung wird geprüft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking permission"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando permissão"
          }
        }
      }
    },
    "iOS can deliver message and call alerts for Veyra.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS kann Nachrichten- und Anrufhinweise für Veyra anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS can deliver message and call alerts for Veyra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS pode exibir alertas de mensagens e chamadas do Veyra."
          }
        }
      }
    },
    "Incoming calls": {
      "localizations": {
        "de": {
          "stringUnit": {
