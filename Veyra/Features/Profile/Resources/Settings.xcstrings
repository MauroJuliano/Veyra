    "Notification permission is managed by iOS and can be changed at any time in System Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitteilungsberechtigung wird von iOS verwaltet und kann jederzeit in den Systemeinstellungen geändert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission is managed by iOS and can be changed at any time in System Settings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de notificações é gerenciada pelo iOS e pode ser alterada a qualquer momento nos Ajustes."
          }
        }
      }
    },
